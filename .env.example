# ============================================================
# Object Storage Platform — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# ─────────────────────────────────────────
# PLATFORM SETTINGS
# ─────────────────────────────────────────
APP_URL=http://localhost:8000
APP_ENV=production

# ─────────────────────────────────────────
# SQLITE DATABASE
# ─────────────────────────────────────────
# Path relative to project root. Leave default unless moving the db.
DATABASE_PATH=database/database.sqlite

# ─────────────────────────────────────────
# ADMIN CREDENTIALS (first-run seed)
# Change these before first deployment!
# ─────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword

# ─────────────────────────────────────────
# SIGNED URL SECRET
# Generate: openssl rand -hex 32
# ─────────────────────────────────────────
SIGNED_URL_SECRET=change-this-to-a-64-char-hex-secret-generated-by-openssl

# ─────────────────────────────────────────
# MYCLOUD STORAGE ENGINE (default provider)
# ─────────────────────────────────────────
MYCLOUD_STORAGE_ROOT=storage/mycloud
MYCLOUD_URL=http://localhost:8000

# ─────────────────────────────────────────
# LOCAL FILESYSTEM PROVIDER
# ─────────────────────────────────────────
LOCAL_STORAGE_ROOT=storage/uploads
LOCAL_STORAGE_URL=http://localhost:8000

# ─────────────────────────────────────────
# CLOUDFLARE R2 (optional)
# ─────────────────────────────────────────
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=my-bucket
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_PUBLIC_URL=https://files.example.com

# ─────────────────────────────────────────
# AMAZON S3 (optional)
# ─────────────────────────────────────────
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=my-s3-bucket
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
S3_PUBLIC_URL=

# ─────────────────────────────────────────
# BACKBLAZE B2 (optional)
# ─────────────────────────────────────────
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET=my-b2-bucket
B2_APPLICATION_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_PUBLIC_URL=

# ─────────────────────────────────────────
# MINIO (optional, self-hosted)
# ─────────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_BUCKET=my-minio-bucket
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

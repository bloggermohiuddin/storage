{
    "name": "bloggermohiuddin/storage",
    "description": "Self-Hosted Object Storage — S3, R2, B2, MinIO, MyCloud with background migration engine",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "aws/aws-sdk-php": "^3.295"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "StoragePlatform\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "worker": "php cli/worker.php",
        "diag": "php cli/test_providers.php"
    }
}
